LAMMPS (29 Aug 2024 - Update 2)
  using 20 OpenMP thread(s) per MPI task
# Cross-check the full-precision Fortran restart configuration in LAMMPS.
units          lj
atom_style     atomic
boundary       p p p
read_data      from_final_restart.data
Reading data file ...
  orthogonal box = (0 0 0) to (10.021493 10.021493 10.021493)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1000 atoms
  read_data CPU = 0.010 seconds

# Fortran: s_ij * exp[-kappa*(r-sigma)]/(r/sigma)
# LAMMPS:  A_ij * exp(-kappa*r)/r
# Thus A_ij = s_ij * sigma*exp(kappa*sigma).
variable       amplitude equal exp(6.0)
pair_style     yukawa 6.0 3.5
pair_coeff     1 1 ${amplitude}
pair_coeff     1 1 403.428793492735
pair_coeff     1 2 -${amplitude}
pair_coeff     1 2 -403.428793492735
pair_coeff     2 2 ${amplitude}
pair_coeff     2 2 403.428793492735
pair_modify    shift no

thermo         1
thermo_style   custom step atoms vol density pe press
thermo_modify  norm no format float %.12g
run            0
WARNING: No fixes with time integration, atoms won't move (src/verlet.cpp:60)
